# Public capability catalog and response-only observation profile.
# This profile deliberately keeps ingestion disabled: do not add ATI_SERVICE_TOKEN here.
PORT=8080
ATI_SERVICE_HOST=0.0.0.0

# The public routes GET /health, GET /v1/catalog and GET /v1/observe need no secret.
# POST /v1/analyze remains disabled until an operator configures ATI_SERVICE_TOKEN separately.

# No source refresh, client IP persistence, cookies, bodies or header values are enabled.
ATI_NETWORK_ACCESS=disabled
ATI_REFRESH_SOURCES=false
