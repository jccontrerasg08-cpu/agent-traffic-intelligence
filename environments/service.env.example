# Technical observe-only service. Configure real secrets in Railway or a local ignored file.
PORT=8080
ATI_SERVICE_HOST=0.0.0.0
ATI_SERVICE_TOKEN=replace-with-a-test-or-deployment-secret
ATI_HASH_KEY=replace-with-a-non-production-hash-key
ATI_MAX_REQUEST_BYTES=10000000
ATI_MAX_BATCH_EVENTS=1000
ATI_MAX_LINE_CHARACTERS=1000000
ATI_MAX_CLIENTS=10000
ATI_MAX_EVENTS_PER_CLIENT=128
ATI_SESSION_WINDOW_SECONDS=900
