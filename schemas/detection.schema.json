{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-traffic-intelligence/detection.schema.json",
  "title": "ATI Detection",
  "type": "object",
  "required": ["request_id", "automation_score", "ai_score", "identity_confidence", "risk_score", "identity", "evidence", "features", "ruleset_version"],
  "properties": {
    "request_id": {"type": "string"},
    "automation_score": {"type": "number", "minimum": 0, "maximum": 1},
    "ai_score": {"type": "number", "minimum": 0, "maximum": 1},
    "identity_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "risk_score": {"type": "number", "minimum": 0, "maximum": 1},
    "identity": {"type": ["object", "null"]},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "features": {"type": "object"},
    "ruleset_version": {"type": "string"},
    "verification": {"$ref": "verification.schema.json"}
  }
}
